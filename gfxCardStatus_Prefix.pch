//
// Prefix header for all source files of the 'gfxCardStatus' target in the 'gfxCardStatus' project
//

#ifdef __OBJC__
    #import <Cocoa/Cocoa.h>

    #define GSLogDebug(msg, ...) NSLog(@"dbg: " msg, ## __VA_ARGS__)
    #define GSLogInfo(msg, ...) NSLog(@"info: " msg, ## __VA_ARGS__)
    #define GSLogError(msg, ...) NSLog(@"err: " msg, ## __VA_ARGS__)

    #ifndef DEBUG
    #undef GSLogDebug
    #define GSLogDebug(...) do {} while(0)
    #endif

    #define Str(key) NSLocalizedString(key, key)

    // This fork. Support, downloads, and issues. Not the original gfx.io site.
    #define kApplicationWebsiteURL @"https://github.com/derekgboyer/gfxCardStatus"
    #define kOriginalProjectURL @"https://github.com/codykrieger/gfxCardStatus"
    // Original author's site. Donations there support Cody Krieger, not this fork.
    #define kOriginalAuthorWebsiteURL @"https://gfx.io"
    #define kIntegratedOnlyMessageExplanationURL @"https://github.com/derekgboyer/gfxCardStatus#integrated-only-limitations"

    static inline void GSOpenURL(NSURL *url) {
        if (url == nil)
            return;
        [[NSWorkspace sharedWorkspace] openURL:url
                                 configuration:[NSWorkspaceOpenConfiguration configuration]
                             completionHandler:nil];
    }
#endif
