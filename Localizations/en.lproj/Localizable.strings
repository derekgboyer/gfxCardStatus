/* Automatic rules */
"PowerSourceRules" = "Power source";
"AutomaticRules" = "Automatic rules";
"AutomaticRulesHelp" = "Every rule below is off until you turn it on. While a rule is on, gfxCardStatus uses this order: a manual choice, then Pause, then per-app, then an external display, then the battery threshold, then the first matching schedule, then the power source (including Don't Change), then the launch or wake rule. Integrated Only is skipped while the discrete GPU is in use. Quitting still returns the Mac to Dynamic Switching.";
"PerAppRule" = "Per-app";
"PerAppEnabled" = "Switch while chosen apps are running";
"PerAppHelp" = "If a chosen app is running and asks for the discrete GPU, that wins. Otherwise a chosen app can request Integrated Only. Apps that are not in the list are ignored.";
